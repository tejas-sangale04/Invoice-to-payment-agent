# Copy to frontend/.env.local. These are public Firebase web config values, not secrets.
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-invoiceflow.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-invoiceflow
# true = use the local Auth emulator (127.0.0.1:9099)
VITE_USE_AUTH_EMULATOR=true
