# Copy to backend/.env for local development. Never commit real values.
GOOGLE_CLOUD_PROJECT=demo-invoiceflow
FIRESTORE_DATABASE=(default)
CORS_ORIGINS=["http://localhost:5173"]

# Local emulators (set by `firebase emulators:start`; leave empty in production)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Used from Phase 4 onwards (Gemini via Vertex AI, same as Coffee-Barista)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=asia-south1
