# Copy to backend/.env for local development. Never commit real values.
GOOGLE_CLOUD_PROJECT=demo-invoiceflow
FIRESTORE_DATABASE=(default)
CORS_ORIGINS=["http://localhost:5173"]

# Local emulators (set by `firebase emulators:start`; leave empty in production)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Invoice files and background jobs. Production: STORAGE_MODE=gcs, GCS_BUCKET=...,
# TASKS_MODE=cloud_tasks, TASKS_SERVICE_ACCOUNT=..., API_BASE_URL=https://<api>.run.app
API_BASE_URL=http://localhost:8000
STORAGE_MODE=local
TASKS_MODE=inline

# Extraction Agent: Gemini via Vertex AI, same as Coffee-Barista. Without Google Cloud
# credentials locally, set EXTRACTOR=disabled and invoices go straight to review.
EXTRACTOR=disabled
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=asia-south1
