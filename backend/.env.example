# Copy to backend/.env for local development. Never commit real values.
GOOGLE_CLOUD_PROJECT=demo-invoiceflow
# Firebase Auth/Firestore project when it differs from GOOGLE_CLOUD_PROJECT. To try real Gemini
# against the emulators, set GOOGLE_CLOUD_PROJECT to your project and keep this demo-invoiceflow.
FIREBASE_PROJECT_ID=demo-invoiceflow
FIRESTORE_DATABASE=(default)
CORS_ORIGINS=["http://localhost:5173"]

# Local emulators (set by `firebase emulators:start`; leave empty in production)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Invoice files and background jobs. Production: STORAGE_MODE=gcs, GCS_BUCKET=...,
# TASKS_MODE=cloud_tasks, TASKS_SERVICE_ACCOUNT=..., API_BASE_URL=https://<api>.run.app
API_BASE_URL=http://localhost:8000
STORAGE_MODE=local
TASKS_MODE=inline

# Extraction Agent: Gemini via Vertex AI, same as Coffee-Barista. Without Google Cloud
# credentials locally, set EXTRACTOR=disabled and invoices go straight to review.
EXTRACTOR=disabled
# Explanation and Resolution agents: unset follows EXTRACTOR. With "disabled", explanations use
# a template and invoices without a PO number go to a person.
# EXCEPTION_AGENTS=gemini
# Dashboard AI cost estimate: USD per million tokens, and the exchange rate.
# GEMINI_INPUT_USD_PER_MTOK=0.30
# GEMINI_OUTPUT_USD_PER_MTOK=2.50
# USD_TO_INR=88
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=asia-south1
# Service account key for Vertex AI when running locally (keep it outside the repo).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Emails to suppliers (rejections and questions about held invoices). Off until you set it up.
# Any SMTP service works. Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, the SMTP login
# from Brevo's SMTP & API page as SMTP_USERNAME and an SMTP key as SMTP_PASSWORD; EMAIL_FROM
# must be a sender or domain verified in Brevo. Gmail: smtp.gmail.com with an app password.
# EMAIL_MODE=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true          # false for port 465 (SSL)
# EMAIL_FROM=Brew & Bake Accounts <accounts@yourcompany.in>
# EMAIL_REPLY_TO=accounts@yourcompany.in
